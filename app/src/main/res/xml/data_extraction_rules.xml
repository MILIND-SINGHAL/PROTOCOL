<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include general user preferences and protocol settings -->
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <!-- Exclude sensitive auth credentials, RevenueCat custom API key, and room database -->
        <exclude domain="sharedpref" path="revenuecat_prefs.xml"/>
        <exclude domain="database" path="protocol_wellness.db"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <exclude domain="sharedpref" path="revenuecat_prefs.xml"/>
        <exclude domain="database" path="protocol_wellness.db"/>
    </device-transfer>
</data-extraction-rules>
